# Application directories
DATA_DIR=./data
UPLOAD_DIR=./data/uploads
OUTPUT_DIR=./data/outputs
REPORTS_DIR=./data/reports
VIZ_DIR=./data/viz

# CORS
ALLOW_ORIGINS=["*"]

# Documentation URLs
DOCS_URL=/docs
REDOC_URL=/redoc

# SMTP settings (optional; when not set, email endpoint uses dry-run)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# Logging
LOG_LEVEL=INFO
